    <string name="onboarding_stuck">Jäid hätta?</string>
    <string name="onboarding_welcome_ask_title">Ütle lihtsalt, mida vajad</string>
    <string name="onboarding_welcome_ask_text">„Vasta Samile, et jään hiljaks“, „lisa ostukorvi piim“.</string>
    <string name="onboarding_welcome_plan_title">Sinu olemasolev pakett</string>
    <string name="onboarding_welcome_plan_text">Claude Code kasutab Claude\'i paketti, Codex ChatGPT paketti, Antigravity Google\'i kontot ja Grok X-i või Google\'i kontot. OpenCode pakub ka tasuta mudeleid.</string>
    <string name="onboarding_welcome_control_title">Kontroll jääb sulle</string>
    <string name="onboarding_welcome_control_text">Saatmine, avaldamine, ostmine ja kustutamine vajavad kinnitust.</string>
    <string name="onboarding_welcome_time">seadistus kestab umbes 5 minutit</string>
    <string name="onboarding_brain_claude">Kasutab sinu Claude\'i Pro või Max paketti.</string>
    <string name="onboarding_brain_codex">Kasutab sinu ChatGPT paketti.</string>
    <string name="onboarding_brain_opencode">Konto pole vajalik. Hiljem saad oma teenusepakkujad lisada.</string>
    <string name="onboarding_brain_local_title">Kohalik mudel</string>
    <string name="onboarding_brain_local">Ollama, LM Studio või llama.cpp sinu enda arvutis või serveris. Mudel töötab OpenCode\'i kaudu.</string>
    <string name="onboarding_access_privacy_local">Kohaliku mudeli puhul läheb ekraanisisu sinu enda serverisse, mitte AI-ettevõttele. Saatmine, avaldamine, ostmine ja kustutamine nõuavad kinnitust.</string>
    <string name="onboarding_local_server_title">Sinu mudeliserver</string>
    <string name="onboarding_local_server_none">Pole veel lisatud</string>
    <string name="onboarding_local_server_added">Lisatud: %1$s</string>
    <string name="onboarding_local_server_text">Käivita oma serveris Ollama, LM Studio või llama.cpp ja lisa selle aadress. Vaja on mudelit, mis oskab tööriistu usaldusväärselt kasutada.</string>
    <string name="onboarding_local_server_add">Lisa server</string>
    <string name="onboarding_brain_agy">Kasutab sinu Google\'i kontot, ka Google AI Pro või Ultra paketiga.</string>
    <string name="onboarding_brain_grok">Kasutab sinu Groki kontot (sisselogimine Google\'i või X-iga).</string>
    <string name="onboarding_brain_both">Paigalda mõlemad ja vali vestluse kaupa. Vaikimisi kasutatakse Claude Code\'i.</string>
    <string name="onboarding_recommended">soovitatud</string>
    <string name="onboarding_access_done">Ligipääsetavus on sisse lülitatud.</string>
    <string name="onboarding_access_text">NOX01 ligipääsetavusteenus kuvab mulli ja võimaldab agendil sinu ülesande täitmiseks ekraani lugeda, puudutada ja teksti sisestada.</string>
