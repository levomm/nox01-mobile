    <!-- Onboarding and notification automation -->
    <string name="onboarding_skip_title">Kas jätta seadistus vahele?</string>
    <string name="onboarding_skip_text">Saad seadistuse hiljem seadetes lõpetada. Enne seda vestlused ei tööta.</string>
